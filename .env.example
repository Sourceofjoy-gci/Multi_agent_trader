# Development-only placeholders. Replace every value outside local development.
#
# Docker Compose reads this file automatically to provision the database roles.
# The application does NOT: RuntimeSettings has no env_file, so a checked-in
# .env can never become a silent source of production configuration. Export
# TRADING_HOUSE_* into your shell for the CLI to see them.

# Consumed by compose.yaml when creating roles on first initialisation.
POSTGRES_ADMIN_PASSWORD=development-only-admin-password
TRADING_HOUSE_MIGRATION_PASSWORD=development-only-migrator-password
TRADING_HOUSE_RUNTIME_PASSWORD=development-only-runtime-password

# Consumed by the application. Runtime connects as trading_house_runtime, which
# can append through audit.append_event and read the ledger, but cannot INSERT,
# UPDATE, DELETE or TRUNCATE it, and cannot migrate.
TRADING_HOUSE_DATABASE_DSN=postgresql://trading_house_runtime:development-only-runtime-password@127.0.0.1:5432/trading_house

# Phase 8A research ledger. TRADING_HOUSE_RESEARCH_DATABASE is consumed by
# compose.yaml, which creates that database on a fresh cluster; it defaults to
# trading_house_research when unset, and init-roles.sh honours it for the CREATE
# DATABASE and for every grant and ALTER DATABASE against it. The DSN's dbname
# must name the database compose created, and must NOT be the one below: a
# research DSN pointing at the application database is refused as configuration
# invalid, before any connection is opened. TRADING_HOUSE_RESEARCH_LEDGER_DSN is
# consumed by the application, and is optional there -- only a `research trial`
# command needs it, and every other command starts without it.
TRADING_HOUSE_RESEARCH_DATABASE=trading_house_research
TRADING_HOUSE_RESEARCH_LEDGER_DSN=postgresql://trading_house_runtime:development-only-runtime-password@127.0.0.1:5432/trading_house_research

# Content-addressed evidence bundles. Relative to the working directory.
TRADING_HOUSE_EVIDENCE_ROOT=.local/evidence

# Optional. These default to the checked-in public artifacts.
# TRADING_HOUSE_CONSTITUTION_PATH=config/risk_constitution.yaml
# TRADING_HOUSE_CONSTITUTION_SIGNATURE_PATH=config/risk_constitution.yaml.sig
# TRADING_HOUSE_CONSTITUTION_PUBLIC_KEY_PATH=config/risk_constitution.public.pem
